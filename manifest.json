{
  "manifest_version": 3,
  "name": "Carrier Comparison Companion",
  "version": "1.2.0",
  "description": "Compare AusPost, eParcel, and CouriersPlease shipping rates on Aimex LogicSync order pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Carrier Comparison Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "couriersplease_headers",
        "enabled": true,
        "path": "rules/couriersplease-headers.json"
      }
    ]
  },
  "host_permissions": [
    "https://aimexaustralia.logicsync.app/*",
    "https://digitalapi.auspost.com.au/*",
    "https://api.couriersplease.com.au/*",
    "https://api-test.couriersplease.com.au/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
