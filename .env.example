# Australia Post PAC (Postage Assessment Calculator)
# Get your key at: https://developers.auspost.com.au/apis/pac
AUSPOST_PAC_API_KEY=

# Australia Post eParcel (Shipping & Tracking contract rates)
# Get your key at: https://developers.auspost.com.au/apis/shipping-and-tracking
AUSPOST_SHIPPING_API_KEY=
AUSPOST_ACCOUNT_NUMBER=
AUSPOST_SHIPPING_API_PASSWORD=

# CouriersPlease
# Note: https://apidev.couriersplease.com.au is the Developer Portal/Docs site.
# Production API: https://api.couriersplease.com.au
# Sandbox API:    https://api-test.couriersplease.com.au
COURIERSPLEASE_API_KEY=
COURIERSPLEASE_ACCOUNT=
COURIERSPLEASE_BASE_URL=https://api.couriersplease.com.au

# Dispatch origin address
ORIGIN_STREET=26/191 McCredie Rd
ORIGIN_SUBURB=Smithfield
ORIGIN_STATE=NSW
ORIGIN_POSTCODE=2164
